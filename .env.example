# Copy to .env.local for local development, and set the same in Vercel's dashboard
# (Project → Settings → Environment Variables). Never commit real values.

# Leaderboards
RAZED_REFERRAL_KEY=""
RAZEDIO_API_KEY=""

# Kick login (kick.com → Settings → Developer → your app)
KICK_CLIENT_ID=""
KICK_CLIENT_SECRET=""
# Signs the login cookie. Any long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=""

# BotRix points (the bid token from the BotRix dashboard; treat it like a password)
BOTRIX_BID=""

# Storage for orders, raffles and store items. Vercel → Storage → Neon adds this for you.
# Leave empty locally to save into .data/ instead.
DATABASE_URL=""

# Optional: also post contact-form messages to a Discord channel (Server settings → Integrations → Webhooks)
# CONTACT_DISCORD_WEBHOOK=""

# Optional overrides
# ADMIN_KICK_USERNAMES="rekoj,aspect900"   # comma-separated Kick usernames allowed into /admin
# AUTH_URL="https://rekoj.org"  # public origin for the Kick redirect, if it can't be inferred
# BOTRIX_CHANNEL="rekoj"
# RAZED_API_URL="https://api.razed.com/player/api/v1/referrals/leaderboard"
# RAZED_REFERRAL_CODE="rekoj"
# RAZEDIO_API_URL=""
# RAZEDIO_REFERRAL_CODE="rekoj"
